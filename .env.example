# =============================================================================
# TotalTidy — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# Never commit `.env.local` — it is git-ignored.
#
# Legend:
#   [REQUIRED]  — app will not start without this
#   [OPTIONAL]  — has a sensible default or is only needed in specific environments
#   [AUTO]      — set automatically by the platform (do not set manually)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon serverless Postgres)
# -----------------------------------------------------------------------------
# [REQUIRED] Connection string for your Neon Postgres database.
# Get yours at https://console.neon.tech → project → Connection Details
DATABASE_URL="postgresql://user:password@host.neon.tech/totaltidy?sslmode=require"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# [REQUIRED] Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# [OPTIONAL] Canonical app URL. Required in production; defaults to http://localhost:3000 locally.
AUTH_URL="http://localhost:3000"

# [REQUIRED] Google OAuth credentials — https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID with redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# [REQUIRED] Resend API key for magic-link emails — https://resend.com/api-keys
AUTH_RESEND_KEY=""

# [OPTIONAL] "From" address for magic-link emails. Defaults to "TotalTidy <noreply@totaltidy.com>".
AUTH_EMAIL_FROM="TotalTidy <noreply@totaltidy.com>"

# -----------------------------------------------------------------------------
# Cloudinary — https://console.cloudinary.com/settings
# -----------------------------------------------------------------------------
# Server-side credentials (NEVER expose these to the client)
# [REQUIRED] Find these in your Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# [REQUIRED] Secret for verifying Cloudinary webhook signatures.
# Set this to a strong random string, then configure the same value in
# Cloudinary Dashboard → Settings → Notifications → Webhook notification URL.
CLOUDINARY_WEBHOOK_SECRET=""

# Client-side variables (NEXT_PUBLIC_ prefix exposes them to the browser)
# [REQUIRED] Must match CLOUDINARY_CLOUD_NAME above.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# [REQUIRED] Name of the unsigned upload preset.
# Run `npm run cloudinary:setup` to create it automatically, or create one
# manually in Cloudinary Dashboard → Settings → Upload → Upload presets.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# -----------------------------------------------------------------------------
# Vercel (platform-injected — no manual setup needed)
# -----------------------------------------------------------------------------
# [AUTO] VERCEL_URL is injected by Vercel at runtime for server-side base URL resolution.
# Do not set this locally — AUTH_URL handles local dev.
