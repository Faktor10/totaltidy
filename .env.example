# =============================================================================
# TotalTidy — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Never commit `.env` — it is git-ignored.
#
# Legend:
#   [REQUIRED]  — app will not start without this
#   [OPTIONAL]  — has a sensible default, or the feature degrades gracefully
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL — Neon, Railway, or a local instance)
# -----------------------------------------------------------------------------
# [REQUIRED] Standard Postgres connection string. Migrations are applied
# automatically when the API server boots, in every environment.
DATABASE_URL="postgresql://user:password@localhost:5432/totaltidy"

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# [OPTIONAL] Port the Express/tRPC API listens on. Defaults to 3001.
PORT="3001"

# [OPTIONAL] Canonical URL of the API itself. Used for the Google OAuth callback
# and the Cloudinary webhook notification URL. Defaults to http://localhost:$PORT.
# This can be a public address (e.g. on Replit) — it is NOT used for the dev
# proxy below, so setting it publicly will not break local requests.
SERVER_URL="http://localhost:3001"

# [OPTIONAL] Where the Vite dev server proxies /api and /trpc requests to, from
# inside the same container/host the client is running in. Defaults to
# http://localhost:3001. Keep this a local address even when SERVER_URL above
# is public (e.g. on Replit) — pointing it at a public URL that itself routes
# back into Vite creates a proxy loop and every /api request hangs forever.
VITE_PROXY_TARGET="http://localhost:3001"

# [OPTIONAL] Where the browser app lives. Used for CORS in dev and for the
# post-sign-in redirect. Defaults to http://localhost:3000.
# In production the API serves the built client itself, so set this to the
# same public origin as SERVER_URL.
CLIENT_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Auth (server-issued session cookies)
# -----------------------------------------------------------------------------
# [REQUIRED] Signs the session cookie — generate with: openssl rand -base64 32
AUTH_SECRET=""

# [OPTIONAL] Google OAuth via Passport — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {SERVER_URL}/api/auth/google/callback
# Unset: the Google button is hidden on the sign-in page; magic link still works.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# [OPTIONAL] Resend API key for magic-link sign-in — https://resend.com/api-keys
# Unset: the email form still works, but the sign-in link is written to the
# server log instead of being emailed. Set this for production.
AUTH_RESEND_KEY=""

# [OPTIONAL] "From" address for magic-link emails.
AUTH_EMAIL_FROM="TotalTidy <noreply@totaltidy.com>"

# -----------------------------------------------------------------------------
# Cloudinary — https://console.cloudinary.com/settings
# -----------------------------------------------------------------------------
# Server-side credentials (NEVER expose these to the client)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# [REQUIRED for webhooks] Verifies Cloudinary webhook signatures. Configure the
# same value in Cloudinary Dashboard → Settings → Notifications, pointing at
# {SERVER_URL}/api/webhooks/cloudinary
CLOUDINARY_WEBHOOK_SECRET=""

# Client-side variables. Vite exposes only the VITE_ prefix to the browser.
# [REQUIRED] Must match CLOUDINARY_CLOUD_NAME above.
VITE_CLOUDINARY_CLOUD_NAME=""

# [REQUIRED] Name of the unsigned upload preset.
# Run `npm run cloudinary:setup` to create it, or create one manually in
# Cloudinary Dashboard → Settings → Upload → Upload presets.
VITE_CLOUDINARY_UPLOAD_PRESET=""
