# =============================================================================
# TotalTidy — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# Never commit `.env.local` — it is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon serverless Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host.neon.tech/totaltidy?sslmode=require"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical app URL (required in production, optional for local dev)
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (magic-link email) — https://resend.com/api-keys
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="TotalTidy <noreply@totaltidy.com>"

# -----------------------------------------------------------------------------
# Cloudinary — https://console.cloudinary.com/settings
# -----------------------------------------------------------------------------
# Server-side (NEVER expose these to the client)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_WEBHOOK_SECRET=""

# Client-side (prefixed with NEXT_PUBLIC_ so Next.js exposes them to the browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# -----------------------------------------------------------------------------
# Vercel (set automatically on Vercel deploys — no action needed locally)
# -----------------------------------------------------------------------------
# VERCEL_URL is injected by Vercel at runtime; do not set manually.
